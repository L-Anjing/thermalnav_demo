Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Image
      Name: BEV RGB preview
      Enabled: true
      Topic:
        Value: /thermalnav/bev/rendered
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: Inspection Coverage
      Enabled: false
      Topic:
        Value: /thermalnav/bev/coverage_rendered
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Occupancy in odom
      Enabled: true
      Topic:
        Value: /thermalnav/bev
        Durability Policy: Transient Local
      Alpha: 1.0
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: Raw Coverage OccupancyGrid (toggle for diagnosis)
      Enabled: false
      Topic:
        Value: /thermalnav/coverage
        Durability Policy: Transient Local
      Alpha: 0.4
      Color Scheme: costmap
    - Class: rviz_default_plugins/MarkerArray
      Name: Candidates selected targets policy
      Enabled: true
      Marker Topic:
        Value: /thermalnav/markers
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PointCloud2
      Name: Fused occupied voxels
      Enabled: false
      Topic:
        Value: /thermalnav/occupied_voxels
        Durability Policy: Transient Local
      Size (m): 0.08
      Style: Boxes
    - Class: rviz_default_plugins/PointCloud2
      Name: Sparse stereo geometry
      Enabled: true
      Topic:
        Value: /thermalnav/stereo/points
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/Image
      Name: Stereo matches
      Enabled: true
      Topic:
        Value: /thermalnav/stereo/matches
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Robot trajectory
      Enabled: true
      Topic:
        Value: /thermalnav/trajectory
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Image
      Name: RGB Thermal proxy
      Enabled: true
      Topic:
        Value: /robot0/front_cam/rgb
        Reliability Policy: Best Effort
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 18
