Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Global Options:
    Fixed Frame: odom
    Frame Rate: 15
    Background Color: 0; 0; 0
  Displays:
    - Class: rviz_default_plugins/Odometry
      Name: Live Robot Odometry
      Enabled: true
      Value: true
      Topic:
        Value: /robot0/odom
        Reliability Policy: Reliable
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Value: Arrow
        Color: 255; 45; 45
        Alpha: 1
        Axes Length: 0.5
        Axes Radius: 0.05
        Head Length: 0.15
        Head Radius: 0.08
        Shaft Length: 0.4
        Shaft Radius: 0.04
    - Class: rviz_default_plugins/Grid
      Name: Metric Grid (1 m)
      Enabled: true
      Value: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 40
      Alpha: 0.25
      Color: 85; 87; 83
      Offset:
        Z: -0.03
    - Class: rviz_default_plugins/Axes
      Name: World Axes
      Enabled: true
      Value: true
      Reference Frame: <Fixed Frame>
      Length: 0.5
      Radius: 0.025
    - Class: rviz_default_plugins/TF
      Name: TF (diagnostic)
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Image
      Name: RGB Camera
      Enabled: true
      Value: true
      Topic:
        Value: /robot0/front_cam/rgb
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: Semantic Synthetic Thermal (display only)
      Enabled: true
      Value: true
      Topic:
        Value: /thermalnav/thermal/colorized
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Map
      Name: Geometry Occupancy
      Enabled: true
      Value: true
      Topic:
        Value: /thermalnav/bev
        Durability Policy: Transient Local
      Alpha: 1.0
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: Thermal Scan Mask (toggle geometry off to view)
      Enabled: false
      Value: false
      Topic:
        Value: /thermalnav/scan_mask
        Durability Policy: Transient Local
      Alpha: 1.0
      Color Scheme: map
    - Class: rviz_default_plugins/MarkerArray
      Name: Frontier and Inspection Candidates
      Enabled: false
      Value: false
      Topic:
        Value: /thermalnav/baseline/candidates
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Pose
      Name: Selected Waypoint
      Enabled: false
      Value: false
      Topic:
        Value: /thermalnav/baseline/selected_goal
        Durability Policy: Transient Local
      Color: 255; 220; 0
    - Class: rviz_default_plugins/Path
      Name: Robot Trajectory
      Enabled: true
      Value: true
      Topic:
        Value: /thermalnav/trajectory
        Durability Policy: Transient Local
      Color: 0; 80; 255
    - Class: rviz_default_plugins/MarkerArray
      Name: Thermal Proxy Person Candidates
      Enabled: false
      Value: false
      Topic:
        Value: /thermalnav/thermal/markers
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PointCloud2
      Name: Occupied surfaces - 3D (includes floor)
      Enabled: false
      Value: false
      Topic:
        Value: /thermalnav/occupied_voxels
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Style: Points
      Size (Pixels): 3
      Size (m): 0.05
    - Class: rviz_default_plugins/PointCloud2
      Name: Collision-height obstacles - 3D
      Enabled: false
      Value: false
      Topic:
        Value: /thermalnav/obstacle_voxels
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Style: Points
      Size (Pixels): 3
      Size (m): 0.05
    - Class: rviz_default_plugins/MarkerArray
      Name: Decision Space - raw reachable rejected selected labels
      Enabled: true
      Value: true
      Topic:
        Value: /thermalnav/exploration/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Validated Candidate Path (not SRU trajectory prediction)
      Enabled: true
      Value: true
      Topic:
        Value: /thermalnav/exploration/selected_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color: 180; 65; 255
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz_default_plugins/Image
      Name: BEV Decision Image (independent preview)
      Enabled: true
      Value: true
      Topic:
        Value: /thermalnav/bev/decision_image
        Reliability Policy: Reliable
        Durability Policy: Transient Local
  Views:
    Current:
      Class: rviz_default_plugins/XYOrbit
      Name: Current View
      Distance: 18
      Focal Point: {X: 2, Y: 0, Z: 0}
      Pitch: 0.95
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: 2D BEV - top down
        Scale: 50
        Angle: 0
        X: 2
        Y: 0
        Target Frame: <Fixed Frame>
      - Class: rviz_default_plugins/XYOrbit
        Name: 3D Occupancy - orbit
        Distance: 18
        Focal Point: {X: 2, Y: 0, Z: 0}
        Pitch: 0.65
        Yaw: 0.8
        Target Frame: <Fixed Frame>
Window Geometry:
  Baseline IntentNav-style BEV:
    collapsed: true
  Thermal plane coverage (separate image):
    collapsed: true
  Tool Properties:
    collapsed: true
  Selection:
    collapsed: true
  Width: 1500
  Height: 950
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
